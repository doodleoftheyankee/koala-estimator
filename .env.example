# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used in quote links (no trailing slash)
APP_URL=http://localhost:3000

# Email (https://resend.com). If unset, emails are logged instead of sent.
RESEND_API_KEY=
# Fallbacks: each store's own sender and office email (Pricing, Store) are used first.
QUOTE_FROM_EMAIL="Koala Insulation of Newark <quotes@yourdomain.com>"
OFFICE_NOTIFY_EMAIL=office@yourdomain.com

# Optional: Google Maps Distance Matrix for drive time. If unset, estimators type minutes.
GOOGLE_MAPS_API_KEY=

# Optional: satellite roof lookup through the Roof Takeoff site (attic floor, roof surface, wall run
# from the address). The key is Roof Takeoff's PARTNER_KEY; if unset, the lookup button is off.
ROOF_TAKEOFF_URL=https://roof-takeoff-ten.vercel.app
ROOF_TAKEOFF_KEY=

# Nightly learning job (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"). Long random string.
CRON_SECRET=
# Receives a short notice if a nightly learning step fails (a store's own owner report email comes first).
OWNER_REPORT_EMAIL=

# Optional: Google Sheets feed. GOOGLE_EXPORT_KEY reads the first store; other stores:
# GOOGLE_EXPORT_KEYS='{"<store id>":"<long random key>"}'
GOOGLE_EXPORT_KEY=
GOOGLE_EXPORT_KEYS=

# Optional: lat,lng for the roof lookup self-check (/api/roof/check)
ROOF_CHECK_SPOT=
