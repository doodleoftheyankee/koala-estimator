# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used in quote links (no trailing slash)
APP_URL=http://localhost:3000

# Email (https://resend.com). If unset, emails are logged instead of sent.
RESEND_API_KEY=
QUOTE_FROM_EMAIL="Koala Insulation of Newark <quotes@yourdomain.com>"
OFFICE_NOTIFY_EMAIL=office@yourdomain.com

# Optional: Google Maps Distance Matrix for drive time. If unset, estimators type minutes.
GOOGLE_MAPS_API_KEY=

# Nightly learning job (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"). Long random string.
CRON_SECRET=
# Receives a short notice if a nightly learning step fails.
OWNER_REPORT_EMAIL=
