# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used in quote links (no trailing slash)
APP_URL=http://localhost:3000

# The franchise's time zone (an IANA name such as America/Chicago or America/Los_Angeles). Every date
# and time the app prints, and each new quote's "Valid until" day, are in it. Built into the app, so
# set it before the build. Unset (or not a zone): America/New_York. A quote already sent keeps the
# zone it was sent in.
NEXT_PUBLIC_BUSINESS_TIME_ZONE=

# Email (https://resend.com). If unset, emails are logged instead of sent.
RESEND_API_KEY=
QUOTE_FROM_EMAIL="Koala Insulation <quotes@yourdomain.com>"
OFFICE_NOTIFY_EMAIL=office@yourdomain.com

# Optional: Google Maps Distance Matrix for drive time. If unset, estimators type minutes.
GOOGLE_MAPS_API_KEY=

# Optional: satellite roof lookup through the Roof Takeoff site (attic floor, roof surface, wall run
# from the address). The key is Roof Takeoff's PARTNER_KEY; if unset, the lookup button is off.
ROOF_TAKEOFF_URL=https://roof-takeoff-ten.vercel.app
ROOF_TAKEOFF_KEY=

# Nightly learning job (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"). Long random string.
CRON_SECRET=
# Receives a short notice if a nightly learning step fails.
OWNER_REPORT_EMAIL=
